{
    "name": "faysal0x1/marketing-service-module",
    "description": "Marketing service + tracking scripts module for Laravel.",
    "type": "laravel-module",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "laravel",
        "module",
        "marketing"
    ],
    "authors": [
        {
            "name": "Faysal",
            "homepage": "https://github.com/faysal0x1"
        }
    ],
    "require": {
        "php": "^8.2",
        "nwidart/laravel-modules": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\MarketingService\\": ""
        },
        "classmap": [
            "database/seeders"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Modules\\MarketingService\\Tests\\": "tests/"
        }
    },
    "extra": {
        "module-dir": "Modules"
    }
}